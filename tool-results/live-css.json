"[{\"href\":\"https://dadanhandimuttonhotel.edgeone.app/style.css\",\"rules\":\"@import url(\\\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Tiro+Devanagari+Hindi:ital@0;1&family=Nunito:wght@300;400;600;700&display=swap\\\");\\n:root { --dark-red: #7A0C0C; --clay-orange: #C46A2E; --mustard: #D4A017; --mustard-bright: #F4C430; --page-bg: #FDF3E3; --section-alt: #FFF8EE; --section-deep: #F5E6C8; --card-bg: #FFFFFF; --card-bg-warm: #FFF4E0; --border-color: #E8C98A; --border-light: #F0DFB8; --text-dark: #2C1008; --text-body: #4A2010; --text-muted: #7A5030; --text-light: #A07050; --black: #2C1008; --off-white: #FDF3E3; --light-bg: #F5E6C8; }\\n* { box-sizing: border-box; margin: 0px; padding: 0px; }\\nhtml { scroll-behavior: smooth; }\\nbody { font-family: Nunito, sans-serif; background-color: var(--page-bg); color: var(--text-body); overflow-x: hidden; }\\n::-webkit-scrollbar { width: 6px; }\\n::-webkit-scrollbar-track { background: var(--section-deep); }\\n::-webkit-scrollbar-thumb { background: var(--clay-orange); border-radius: 3px; }\\n.navbar { border-bottom: 3px solid var(--dark-red); padding: 10px 0px; position: sticky; top: 0px; z-index: 1050; box-shadow: rgba(122, 12, 12, 0.15) 0px 2px 16px; background: rgb(255, 245, 225) !important; }\\n.navbar-brand { display: flex; align-items: center; gap: 10px; }\\n.brand-logo { width: 48px; height: 48px; object-fit: contain; filter: drop-shadow(rgba(122, 12, 12, 0.35) 0px 0px 6px); flex-shrink: 0; }\\n.brand-text-wrap .brand-name { font-family: \\\"Playfair Display\\\", serif; font-size: clamp(0.85rem, 2.5vw, 1.1rem); font-weight: 700; color: var(--dark-red); line-height: 1.2; letter-spacing: 0.5px; }\\n.brand-text-wrap .brand-sub { font-size: 0.6rem; color: var(--clay-orange); letter-spacing: 2px; text-transform: uppercase; }\\n.navbar-nav .nav-link { font-family: Nunito, sans-serif; font-weight: 700; font-size: 0.88rem; letter-spacing: 0.3px; position: relative; transition: color 0.3s; color: rgb(58, 26, 6) !important; padding: 6px 12px !important; }\\n.navbar-nav .nav-link::after { content: \\\"\\\"; position: absolute; bottom: 0px; left: 12px; right: 12px; height: 2px; background: var(--dark-red); transform: scaleX(0); transition: transform 0.3s; }\\n.navbar-nav .nav-link:hover, .navbar-nav .nav-link.active { color: var(--dark-red) !important; }\\n.navbar-nav .nav-link:hover::after, .navbar-nav .nav-link.active::after { transform: scaleX(1); }\\n@media (max-width: 991px) {\\n  .navbar-collapse { background: rgb(255, 245, 225); border-top: 1px solid rgba(122, 12, 12, 0.15); padding: 8px 0px 12px; margin-top: 8px; }\\n  .navbar-nav .nav-link { padding: 8px 16px !important; }\\n  .navbar-nav .nav-link::after { display: none; }\\n}\\n.navbar-toggler { padding: 4px 8px; border-color: var(--dark-red) !important; }\\n.navbar-toggler-icon { background-image: url(\\\"data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28122,12,12,1%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e\\\") !important; }\\n.hero-section { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: rgb(10, 3, 3); }\\n.hero-bg { position: absolute; inset: 0px; background-image: url(\\\"hero-handi.webp\\\"); background-size: cover; background-position: center 40%; filter: brightness(0.3) blur(0.6px); transform: scale(1.05); transition: transform 8s, filter 1.2s; will-change: transform; }\\n.no-webp .hero-bg { background-image: url(\\\"hero-handi.jpg\\\"); }\\n.hero-bg.loaded { transform: scale(1.01); filter: brightness(0.36) blur(0px); }\\n.steam-wrap { position: absolute; bottom: 0px; left: 50%; transform: translateX(-50%); width: 300px; height: 240px; pointer-events: none; z-index: 1; opacity: 0.5; }\\n.steam-wisp { position: absolute; bottom: 0px; border-radius: 50% 50% 20% 20%; background: radial-gradient(at 50% 80%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 70%); animation: steamWisp var(--dur,3.5s) ease-in var(--del,0s) infinite; transform-origin: center bottom; }\\n.steam-wisp:nth-child(1) { left: 30%; width: 22px; height: 120px; --dur: 3.2s; --del: 0s; }\\n.steam-wisp:nth-child(2) { left: 42%; width: 32px; height: 160px; --dur: 4s; --del: 0.6s; }\\n.steam-wisp:nth-child(3) { left: 55%; width: 26px; height: 140px; --dur: 3.6s; --del: 1.2s; }\\n.steam-wisp:nth-child(4) { left: 65%; width: 20px; height: 110px; --dur: 4.4s; --del: 0.3s; }\\n.steam-wisp:nth-child(5) { left: 20%; width: 18px; height: 90px; --dur: 3.8s; --del: 1.8s; }\\n@keyframes steamWisp { \\n  0% { transform: translateY(0px) scaleX(1) rotate(0deg); opacity: 0; }\\n  10% { opacity: 0.7; }\\n  50% { transform: translateY(-80px) scaleX(1.4) rotate(6deg); opacity: 0.4; }\\n  80% { transform: translateY(-140px) scaleX(1.8) rotate(-4deg); opacity: 0.15; }\\n  100% { transform: translateY(-180px) scaleX(2.2) rotate(2deg); opacity: 0; }\\n}\\n.smoke-overlay { position: absolute; inset: 0px; background: radial-gradient(transparent 25%, rgba(8, 2, 2, 0.75) 100%); pointer-events: none; }\\n.smoke-particle { position: absolute; border-radius: 50%; background: rgba(255, 240, 200, 0.03); animation: auto linear 0s infinite normal none running smokeRise; pointer-events: none; }\\n@keyframes smokeRise { \\n  0% { transform: translateY(100vh) scale(0.5); opacity: 0; }\\n  20% { opacity: 0.6; }\\n  80% { opacity: 0.2; }\\n  100% { transform: translateY(-20vh) scale(2); opacity: 0; }\\n}\\n.hero-content { position: relative; z-index: 2; text-align: center; padding: 48px 20px 64px; width: 100%; }\\n.hero-title-hindi { font-family: \\\"Tiro Devanagari Hindi\\\", serif; font-size: clamp(2.6rem, 7.5vw, 5.5rem); font-weight: 700; color: rgb(255, 255, 255); line-height: 1.12; text-shadow: rgba(0, 0, 0, 0.95) 0px 4px 32px, rgba(196, 106, 46, 0.25) 0px 0px 60px; margin-bottom: 18px; letter-spacing: 1px; }\\n.hero-title-hindi span { color: var(--mustard-bright); }\\n.hero-tagline-hindi { font-family: \\\"Tiro Devanagari Hindi\\\", serif; font-size: clamp(1.05rem, 2.8vw, 1.6rem); color: var(--mustard-bright); font-weight: 700; line-height: 1.6; text-shadow: rgba(0, 0, 0, 0.7) 0px 2px 14px; margin-top: 14px; margin-bottom: 0px; }\\n.hero-tagline-hindi span { display: block; font-size: 87%; color: rgb(240, 192, 96); margin-top: 4px; }\\n.hero-since { font-size: 0.76rem; letter-spacing: 4px; color: var(--clay-orange); text-transform: uppercase; margin-bottom: 15px; }\\n.hero-subtitle { font-size: 0.82rem; color: rgba(255, 255, 255, 0.55); letter-spacing: 2.5px; text-transform: uppercase; margin-top: 6px; margin-bottom: 28px; }\\n.hero-divider { width: 72px; height: 2px; background: linear-gradient(90deg, transparent, var(--mustard-bright), transparent); margin: 14px auto 18px; }\\n.btn-hero-primary { background: linear-gradient(135deg, var(--dark-red), #a01010); color: rgb(255, 255, 255); border: 2px solid rgba(255, 255, 255, 0.12); padding: 12px 26px; font-weight: 700; font-size: 0.88rem; border-radius: 6px; letter-spacing: 0.6px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: 0.3s; box-shadow: rgba(122, 12, 12, 0.5) 0px 4px 18px; min-height: 44px; }\\n.btn-hero-primary:hover { background: linear-gradient(135deg, #a01010, var(--clay-orange)); color: rgb(255, 255, 255); transform: translateY(-2px); box-shadow: rgba(122, 12, 12, 0.55) 0px 8px 26px; }\\n.btn-hero-secondary { background: rgba(255, 255, 255, 0.08); color: rgb(255, 255, 255); border: 2px solid rgba(255, 255, 255, 0.55); padding: 12px 26px; font-weight: 700; font-size: 0.88rem; border-radius: 6px; letter-spacing: 0.6px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: 0.3s; backdrop-filter: blur(4px); min-height: 44px; }\\n.btn-hero-secondary:hover { background: rgba(255, 255, 255, 0.2); color: rgb(255, 255, 255); border-color: rgb(255, 255, 255); transform: translateY(-2px); }\\n.btn-hero-whatsapp { background: linear-gradient(135deg, rgb(27, 122, 61), rgb(37, 168, 78)); color: rgb(255, 255, 255); border: 2px solid rgba(255, 255, 255, 0.12); padding: 12px 26px; font-weight: 700; font-size: 0.88rem; border-radius: 6px; letter-spacing: 0.6px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: 0.3s; min-height: 44px; }\\n.btn-hero-whatsapp:hover { transform: translateY(-2px); box-shadow: rgba(37, 168, 78, 0.4) 0px 8px 20px; color: rgb(255, 255, 255); }\\n.hero-scroll-indicator { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); animation: 2s ease 0s infinite normal none running bounce; color: rgba(255, 255, 255, 0.5); font-size: 1.2rem; z-index: 2; }\\n@keyframes bounce { \\n  0%, 100% { transform: translateX(-50%) translateY(0px); }\\n  50% { transform: translateX(-50%) translateY(8px); }\\n}\\n@media (max-width: 767px) {\\n  .hero-section { min-height: 70vh; align-items: center; }\\n  .hero-content { padding: 24px 16px 28px; }\\n  .hero-title-hindi { font-size: clamp(1.9rem, 9.5vw, 2.8rem); margin-bottom: 10px; }\\n  .hero-tagline-hindi { font-size: clamp(0.88rem, 4.5vw, 1.1rem); margin-top: 8px; }\\n  .hero-subtitle { font-size: 0.64rem; letter-spacing: 1.5px; margin-bottom: 16px; }\\n  .hero-divider { margin: 8px auto 10px; }\\n  .hero-since { font-size: 0.68rem; margin-bottom: 15px; }\\n  .steam-wrap { width: 200px; height: 150px; opacity: 0.38; }\\n  .hero-scroll-indicator { display: none; }\\n  .btn-hero-primary, .btn-hero-secondary, .btn-hero-whatsapp { padding: 10px 18px; font-size: 0.82rem; min-height: 42px; }\\n}\\n@media (min-width: 768px) and (max-width: 991px) {\\n  .hero-section { min-height: 70vh; align-items: center; }\\n  .hero-content { padding: 32px 24px 40px; }\\n  .hero-title-hindi { font-size: clamp(2.6rem, 6vw, 3.6rem); }\\n  .hero-tagline-hindi { font-size: clamp(1rem, 2.6vw, 1.4rem); }\\n  .steam-wrap { width: 250px; }\\n}\\n.section-badge { display: inline-block; background: rgba(196, 106, 46, 0.12); color: var(--clay-orange); border: 1px solid var(--clay-orange); font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; padding: 4px 16px; border-radius: 20px; margin-bottom: 12px; }\\n.section-title { font-family: \\\"Playfair Display\\\", serif; font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 700; color: var(--text-dark); line-height: 1.2; margin-bottom: 12px; }\\n.section-title span { color: var(--dark-red); }\\n.section-divider { width: 60px; height: 3px; background: linear-gradient(90deg, var(--dark-red), var(--clay-orange)); margin: 0px auto 16px; border-radius: 2px; }\\n.section-desc { color: var(--text-muted); font-size: 1rem; max-width: 600px; margin: 0px auto; line-height: 1.7; }\\n.why-section { padding: 90px 0px; background: var(--section-alt); position: relative; }\\n.why-section::before { content: \\\"\\\"; position: absolute; top: 0px; left: 0px; right: 0px; height: 3px; background: linear-gradient(90deg, transparent, var(--clay-orange), transparent); }\\n.feature-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 36px 24px; text-align: center; transition: 0.4s; position: relative; overflow: hidden; height: 100%; box-shadow: rgba(196, 106, 46, 0.08) 0px 2px 12px; }\\n.feature-card::before { content: \\\"\\\"; position: absolute; top: 0px; left: 0px; right: 0px; height: 3px; background: linear-gradient(90deg, var(--dark-red), var(--clay-orange)); transform: scaleX(0); transition: transform 0.4s; }\\n.feature-card:hover { transform: translateY(-8px); border-color: var(--clay-orange); box-shadow: rgba(122, 12, 12, 0.12) 0px 20px 50px; }\\n.feature-card:hover::before { transform: scaleX(1); }\\n.feature-icon { font-size: 2.8rem; margin-bottom: 18px; display: block; }\\n.feature-card h4 { font-family: \\\"Playfair Display\\\", serif; font-size: 1.2rem; color: var(--dark-red); margin-bottom: 10px; }\\n.feature-card p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.7; }\\n.menu-section { padding: 90px 0px; background: var(--page-bg); }\\n.menu-tabs .nav-pills .nav-link { background: transparent; color: var(--text-muted); border: 1px solid var(--border-color); border-radius: 4px; padding: 8px 22px; font-size: 0.85rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; transition: 0.3s; margin: 4px; }\\n.menu-tabs .nav-pills .nav-link:hover, .menu-tabs .nav-pills .nav-link.active { background: var(--dark-red); color: rgb(255, 255, 255); border-color: var(--dark-red); }\\n.dish-card { background: var(--card-bg); border: 1px solid var(--border-light); border-radius: 12px; overflow: hidden; transition: 0.4s; height: 100%; cursor: pointer; box-shadow: rgba(196, 106, 46, 0.07) 0px 2px 10px; }\\n.dish-card:hover { transform: translateY(-6px); box-shadow: rgba(122, 12, 12, 0.15) 0px 16px 40px; border-color: var(--clay-orange); }\\n.dish-img-wrap { overflow: hidden; height: 200px; position: relative; }\\n.dish-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }\\n.dish-card:hover .dish-img-wrap img { transform: scale(1.1); }\\n.dish-badge { position: absolute; top: 10px; right: 10px; background: var(--dark-red); color: rgb(255, 255, 255); font-size: 0.65rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; padding: 3px 10px; border-radius: 3px; }\\n.dish-info { padding: 18px 20px; }\\n.dish-info h5 { font-family: \\\"Playfair Display\\\", serif; font-size: 1.1rem; color: var(--text-dark); margin-bottom: 6px; }\\n.dish-info p { color: var(--text-muted); font-size: 0.82rem; line-height: 1.6; margin-bottom: 12px; }\\n.dish-price { font-weight: 700; color: var(--dark-red); font-size: 0.95rem; }\\n.pricing-section { padding: 60px 0px; background: linear-gradient(135deg, var(--dark-red) 0%, #4a0808 50%, var(--dark-red) 100%); text-align: center; position: relative; overflow: hidden; }\\n.pricing-section::before { content: \\\"🍲\\\"; position: absolute; font-size: 15rem; opacity: 0.05; left: -3rem; top: 50%; transform: translateY(-50%); }\\n.pricing-section::after { content: \\\"🫕\\\"; position: absolute; font-size: 15rem; opacity: 0.05; right: -3rem; top: 50%; transform: translateY(-50%); }\\n.price-badge { display: inline-block; background: rgba(244, 196, 48, 0.15); border: 2px solid var(--mustard); color: var(--mustard); font-family: \\\"Playfair Display\\\", serif; font-size: 2rem; font-weight: 700; padding: 14px 40px; border-radius: 8px; letter-spacing: 2px; box-shadow: rgba(244, 196, 48, 0.2) 0px 0px 30px; }\\n.ratings-section { padding: 90px 0px; background: var(--section-deep); }\\n.star-display { color: var(--clay-orange); font-size: 1.5rem; }\\n.rating-big { font-family: \\\"Playfair Display\\\", serif; font-size: 5rem; font-weight: 900; color: var(--dark-red); line-height: 1; }\\n.review-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 28px; transition: 0.3s; display: none; box-shadow: rgba(196, 106, 46, 0.08) 0px 4px 16px; }\\n.review-card.active { display: block; }\\n.review-card:hover { border-color: var(--clay-orange); }\\n.review-text { font-style: italic; color: var(--text-muted); font-size: 0.95rem; line-height: 1.8; margin-bottom: 16px; }\\n.reviewer-name { font-weight: 700; color: var(--text-dark); font-size: 0.95rem; }\\n.reviewer-location { color: var(--clay-orange); font-size: 0.8rem; }\\n.branches-section { padding: 90px 0px; background: var(--section-alt); }\\n.branch-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; transition: 0.4s; height: 100%; box-shadow: rgba(196, 106, 46, 0.08) 0px 2px 12px; }\\n.branch-card:hover { transform: translateY(-6px); border-color: var(--clay-orange); box-shadow: rgba(122, 12, 12, 0.12) 0px 16px 40px; }\\n.branch-card.coming-soon { opacity: 0.75; background: repeating-linear-g